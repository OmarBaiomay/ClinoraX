// Phase 1 scaffold — connect PostgreSQL later via DATABASE_URL
// Then run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClinicSize {
  solo
  small
  multi
  unsure
}

enum LeadStatus {
  new
  contacted
  demo_scheduled
  onboarded
  archived
}

model Lead {
  id          String     @id @default(cuid())
  contactName String
  clinicName  String
  phone       String
  email       String?
  clinicSize  ClinicSize @default(unsure)
  message     String?
  locale      String     @default("ar")
  source      String     @default("landing-demo")
  status      LeadStatus @default(new)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String
  locale    String   @default("ar")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

